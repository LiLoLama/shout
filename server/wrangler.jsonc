{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shout-license-webhook",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-03",
  // stripe-Bibliothek braucht Node-Builtins; Ed25519 ist in Workers nativ verfügbar.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
