<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Shout</RootNamespace>
    <AssemblyName>shout</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.1</Version>
    <Product>shout.</Product>
    <Company>inthezone</Company>
    <Description>Lokale, private Diktier-App — Windows-Version</Description>
    <ApplicationIcon>..\..\assets\shout.ico</ApplicationIcon>
    <!-- Erlaubt das Kompilieren des Windows-Targets auch auf macOS/Linux
         (reiner Compile-Check; ausführen kann es nur Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- Das Logo zusätzlich einbetten: so lässt sich zur Laufzeit die passgenaue
         Größe für Fenster (32 px) und Infobereich (16 px) entnehmen. -->
    <EmbeddedResource Include="..\..\assets\shout.ico" LogicalName="shout.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Spracherkennung: whisper.cpp über Whisper.net (bringt die nativen
         CPU-Runtimes für win-x64/win-arm64 mit). -->
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
    <!-- Optionale KI-Formatierung: llama.cpp über LLamaSharp (CPU-Backend). -->
    <PackageReference Include="LLamaSharp" Version="0.24.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.24.0" />
    <!-- Mikrofonaufnahme. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Installer + Auto-Update (Velopack): erzeugt Setup.exe und aktualisiert
         später gegen die GitHub-Releases. Windows-Pendant zu Sparkle am Mac. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
