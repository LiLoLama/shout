<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Gleiche App Group wie die Haupt-App: die Tastatur liest hier den zuletzt
	     diktierten Text, um ihn ins Textfeld einzufügen. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.inthezone.shout</string>
	</array>
</dict>
</plist>
